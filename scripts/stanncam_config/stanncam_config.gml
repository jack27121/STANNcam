///STANNcam config macros, to change certain global behavior for all cameras
/// 

#macro STANNCAM_CONFIG_SNAP_TO_FOLLOW_ON_ROOM_START true //if a followed object is active at the start of a room, should the camera be snapped to it?
#macro STANNCAM_CONFIG_SNAP_TO_ZONE_ON_ROOM_START true   //if a followed object is within a constrain zone at start of room, should thee camera be snapped to it?